# Copy this file to .env and edit the values for your host.

COMPOSE_PROJECT_NAME=atom-observability

# The vLLM OpenAI-compatible server must expose Prometheus metrics at /metrics.
# For a vLLM service running on the Docker host, keep host.docker.internal here.
# For a vLLM service in the same compose network, use service-name:port.
VLLM_METRICS_TARGET=host.docker.internal:7791
VLLM_METRICS_SCHEME=http
VLLM_METRICS_PATH=/metrics
VLLM_SCRAPE_INTERVAL=5s

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Use host-gateway on Linux so containers can reach services bound on the host.
HOST_GATEWAY_NAME=host.docker.internal
HOST_GATEWAY_IP=host-gateway
